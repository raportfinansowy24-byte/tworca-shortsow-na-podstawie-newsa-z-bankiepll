APP_AUTH_SECRET=
APP_LOGIN_PASSWORD=
BANKIER_SHORTS_API_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
OFFER_CATALOG_REFRESH_INTERVAL_MS=
OFFER_CATALOG_SOURCE_URL=
# Gemini 4 Hydrogen key pool (attempted in numbered order)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
# Legacy fallback, if still configured
GEMINI_API_KEY=
# Used only when all Hydrogen keys are unavailable/rate-limited; set to off to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
PEXELS_API_KEY=
PIXABAY_API_KEY=
PEXELS_CACHE_MAX_ENTRIES=
PEXELS_CACHE_TTL_SECONDS=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
TELEGRAM_APPROVER_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REGISTER_WEBHOOK_ON_START=
TELEGRAM_WEBHOOK_SECRET=
# Persistent ElevenLabs full-narration cache retention
TTS_CACHE_TTL_DAYS=30
TTS_CACHE_MAX_BYTES=536870912
# Optional override; defaults to /app/exports/tts-cache on Fly.io
# TTS_CACHE_DIR=/app/exports/tts-cache

