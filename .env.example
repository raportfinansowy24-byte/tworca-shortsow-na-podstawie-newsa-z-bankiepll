# PEXELS_API_KEY: Required for topic/news Auto-Pilot generation.
# Auto-Pilot selects four distinct vertical Pexels videos and fails rather than substituting curated/AI footage.
# Manually supplied scene URLs can still be rendered without this key.
PEXELS_API_KEY=
# Cache wyników wyszukiwania Pexels; domyślnie 6 godzin i maksymalnie 300 zapytań.
PEXELS_CACHE_TTL_SECONDS=21600
PEXELS_CACHE_MAX_ENTRIES=300

# App login: set both values in the deployment secret manager. Never commit real secrets.
# APP_LOGIN_PASSWORD is the password you enter on the login screen.
APP_LOGIN_PASSWORD=
# Generate a random secret of at least 32 characters (for example: openssl rand -hex 32).
APP_AUTH_SECRET=
# Optional machine token for unattended automation; set only in a secret manager.
BANKIER_SHORTS_API_TOKEN=
# The existing 4 daily runs (06:00, 11:00, 16:00, 21:00 Europe/Warsaw) are controlled by
# the single on/off switch in the Auto-Pilot dashboard; fresh installs and migrated old states stay off.

# Optional Supabase job history. Keep the service-role key server-side only; never add it to Vite/client variables.
# Set the project root URL (https://<project>.supabase.co), not /rest/v1/; the server defensively strips that suffix if present.
SUPABASE_URL=
# Preferred name. Use the Supabase secret/service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible aliases also accepted by the server:
# SUPABASE_KEY=
# SUPABASE_SECRET_KEY=

# Required for Telegram approvals/comments. Set these in the deployment secret manager, never in source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Automatically register buttons and comment replies when all required settings and APP_URL are present.
TELEGRAM_REGISTER_WEBHOOK_ON_START=true
# Optional in a private chat (the chat ID is account-bound); required for groups to restrict decisions to you.
TELEGRAM_APPROVER_USER_ID=

# ELEVENLABS_API_KEY: Required when TTS is enabled. There is no Edge or Google TTS fallback.
ELEVENLABS_API_KEY=

# Optional account voice ID. If omitted, the app uses its default ElevenLabs profile;
# the UI can also load and select voices available to this account.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Optional. Defaults to eleven_multilingual_v2 for consistent multilingual narration.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional OpenAI-first provider for news selection and script generation. If absent or if a call fails,
# the app falls back through its Gemini model cascade. Store the real key only in Fly secrets.
OPENAI_API_KEY=
# Optional model override; server code currently defaults to gpt-6.1-sol.
# OPENAI_SCRIPT_MODEL=
# Gemini fallback is configured separately; keep its key server-side in Fly secrets as well.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public offer catalog used only to suggest a category and visible candidates.
# Cards are treated as unverified until checked with the provider; no offer claims are auto-promoted.
OFFER_CATALOG_SOURCE_URL=https://toomasz-money.oferty-kredytowe.pl
OFFER_CATALOG_REFRESH_INTERVAL_MS=21600000
